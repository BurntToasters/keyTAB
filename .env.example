# Copy this file to .env. Shell environment variables override .env values.
# Never commit .env or real credentials.

# Developer ID and Apple notarization
KEYTAB_SIGNING_IDENTITY=Developer ID Application
KEYTAB_NOTARY_PROFILE=

# Sparkle EdDSA signing: configure exactly one source.
KEYTAB_SPARKLE_ACCOUNT=
KEYTAB_SPARKLE_PRIVATE_KEY_FILE=
# Wrap direct multiline key material in double quotes.
KEYTAB_SPARKLE_PRIVATE_KEY=

# GPG signing. Prefer gpg-agent; passphrase is optional for unattended hosts.
KEYTAB_GPG_KEY=
KEYTAB_GPG_PASSPHRASE=

# Optional GitHub CLI token. Existing gh authentication also works.
GH_TOKEN=

# SSH release host keychain. KEYTAB_KEYCHAIN_PASSWORD is preferred.
KEYTAB_KEYCHAIN_PASSWORD=
SSH_USER_PWD=
KEYTAB_KEYCHAIN_PATH=
